# ────────────────────────────────────────────────────────────────────────────
# AssetGuard Backend Environment Variables
# ────────────────────────────────────────────────────────────────────────────
# DO NOT commit .env files with real secrets.
# Copy this to .env and fill in your actual values.

# ── Server Configuration ──────────────────────────────────────────────────────
# Port for the backend server (Render will provide this automatically)
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=AppName
MONGODB_URI=

# ── Authentication ────────────────────────────────────────────────────────────
# JWT secret key for token signing (generate with: openssl rand -hex 32)
JWT_SECRET=

# ── Email Service (Resend) ────────────────────────────────────────────────────
# API key from https://resend.com
RESEND_API_KEY=

# Email address to send from (must be verified in Resend)
RESEND_FROM_EMAIL=

# ── ML Server ─────────────────────────────────────────────────────────────────
# URL of the Python ML server for room prediction
# Development: http://localhost:8000
# Production: https://your-ml-server.onrender.com
ML_API_URL=

# ── Application URLs ──────────────────────────────────────────────────────────
# Base URL of this backend (used for email verification links)
# Development: http://localhost:5000
# Production: https://your-backend.onrender.com
APP_BASE_URL=

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Email verification (true = require email verification, false = bypass)
EMAIL_VERIFICATION_ENABLED=false
